# Polygon Network Configuration

# Private key for deployment (without 0x prefix)
# How to get from MetaMask:
# 1. Open MetaMask
# 2. Click on three dots (⋮) → Account details
# 3. Click "Show private key"
# 4. Enter your MetaMask password
# 5. Copy the key WITHOUT the "0x" prefix
PRIVATE_KEY=your_private_key_here

# RPC URLs

# Polygon Amoy Testnet RPC URL
# RECOMMENDED: Use Alchemy for better reliability and performance
# How to get Alchemy URL:
# 1. Sign up at https://www.alchemy.com/
# 2. Create new app: Chain=Polygon, Network=Polygon Amoy
# 3. Copy the HTTPS URL (format: https://polygon-amoy.g.alchemy.com/v2/YOUR-API-KEY)
# Alternative public RPC (may be slower): https://rpc-amoy.polygon.technology
POLYGON_AMOY_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/YOUR-API-KEY

# Polygon Mainnet RPC URL (for future production deployment)
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR-API-KEY

# PolygonScan API Key (for contract verification)
# How to get:
# 1. Sign up at https://polygonscan.com/
# 2. Go to Profile → API Keys
# 3. Click "Add" and create a new key
# 4. Copy the API key
# Note: Same API key works for both mainnet and testnet
POLYGONSCAN_API_KEY=your_polygonscan_api_key

# Deployed Contract Addresses (filled after deployment)
TOKEN_MANAGER_ADDRESS=
ORDER_BOOK_ADDRESS=
TRADE_ADDRESS=
HTLC_ADDRESS=
CROSS_CHAIN_ORDER_BOOK_ADDRESS=
