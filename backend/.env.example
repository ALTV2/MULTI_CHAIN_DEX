# Database
DB_PASSWORD=your_secure_password_here

# JWT Secret (min 32 characters for HS256)
JWT_SECRET=your-256-bit-secret-key-here-change-in-production-min-32-chars

# Encryption key for wallet storage (exactly 32 bytes)
