<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.0</version>
        <relativePath/>
    </parent>

    <groupId>com.multichain</groupId>
    <artifactId>dex-backend-parent</artifactId>
    <version>2.0.0</version>
    <packaging>pom</packaging>
    <name>Multi-Chain DEX Backend (parent)</name>
    <description>Aggregator for the indexer service and the notification service</description>
    <url>https://github.com/ALTV2/MULTI_CHAIN_DEX</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Alexandr Tveritin</name>
            <email>tveritin09@gmail.com</email>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/ALTV2/MULTI_CHAIN_DEX.git</connection>
        <developerConnection>scm:git:git@github.com:ALTV2/MULTI_CHAIN_DEX.git</developerConnection>
        <url>https://github.com/ALTV2/MULTI_CHAIN_DEX</url>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/ALTV2/MULTI_CHAIN_DEX/issues</url>
    </issueManagement>

    <properties>
        <java.version>21</java.version>
        <web3j.version>4.12.3</web3j.version>
        <springdoc.version>2.5.0</springdoc.version>
        <lombok.version>1.18.36</lombok.version>
        <jacoco.version>0.8.12</jacoco.version>
    </properties>

    <modules>
        <module>indexer-service</module>
        <module>notification-service</module>
    </modules>

    <build>
        <plugins>
            <!-- JaCoCo: code-coverage agent + per-module HTML/CSV report (target/site/jacoco). -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- @{argLine} is the JaCoCo-set agent arg; the ByteBuddy flag is required for
                 Mockito inline mocks on JDK 21. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>@{argLine} -Dnet.bytebuddy.experimental=true</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
