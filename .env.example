# Copy to .env and fill in real values. .env is gitignored — never commit secrets.

# ===== Database =====
DB_NAME=multichain_dex
DB_USER=dex
DB_PASSWORD=dex_password

# ===== Blockchain RPC URLs (server-side only — never exposed to the browser) =====
# Use your own provider keys. Example shows the Alchemy URL shape; replace YOUR_KEY.
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
POLYGON_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/YOUR_KEY
SUI_RPC_URL=https://fullnode.testnet.sui.io:443

# ===== Indexer =====
INDEXER_ENABLED=true
INDEXER_INTERVAL=10000

# ===== CORS =====
CORS_ORIGINS=http://localhost:3000

# ===== Notification service (Kafka + SMTP) =====
# Kafka bootstrap is wired to the in-cluster broker by docker compose / k8s; override only if external.
NOTIFICATIONS_TOPIC=dex.orders
# Defaults target the bundled mailpit sink (docker compose / k8s). For a real provider set host/port/creds.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
NOTIFICATIONS_FROM=noreply@multichain-dex.local

# ===== Frontend (baked into the build) =====
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v2
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id
